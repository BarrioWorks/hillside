    "renderer": {
      "terrainColorFormulas": {
        "variation": "sin(cell.x * 17.23 + cell.z * 7.93 + snapshot.seed) * 0.5 + 0.5",
        "soil": "setHSL(0.1, 0.18, 0.52 + variation * 0.045)",
        "grass": "setHSL(0.235 + variation * 0.012, 0.32, 0.38 + variation * 0.025)",
        "mountainInstances": "setHSL(0.39, 0.12, 0.57 + (i % 3) * 0.035)",
        "leaves": "setHSL(0.29 + (i % 4) * 0.018, 0.24, 0.34 + (i % 5) * 0.025)"
      },
      "outputColorSpace": "SRGBColorSpace",
      "toneMapping": "ACESFilmicToneMapping",
      "exposure": 1.15,
      "fog": {
        "near": 60,
        "far": 150
      },
      "ghostOpacity": 0.53,
      "markerOpacity": 0.4,
      "modelRoughness": 0.9,
      "terrainRoughness": 1
    },
