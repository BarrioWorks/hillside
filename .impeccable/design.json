      "css": ".ds-feedback{font-family:\"Nunito Sans\",sans-serif;display:flex;align-items:center;gap:7px;background:var(--surface,#fff);box-shadow:0 5px 16px #243e3420;border-radius:8px;padding:9px 12px;color:#1948c3;font-size:12px;font-weight:800;max-width:260px;line-height:1.4}.ds-feedback svg{flex-shrink:0}.ds-feedback.ds-invalid{color:#a31f31;background:#fff7f7}"
