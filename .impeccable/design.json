      "css": ".ds-selection{font-family:\"Nunito Sans\",sans-serif;display:flex;align-items:center;gap:10px;min-height:44px;background:#ffffffed;padding:5px 7px 5px 16px;width:fit-content;max-width:100%;border-radius:10px;box-shadow:0 3px 18px #243e3410;font-size:11px;color:#17212f}.ds-selection-title{font-weight:800;font-size:13px;white-space:nowrap}.ds-divider{width:1px;height:14px;background:var(--line,#d9e2ed)}.ds-description{color:var(--secondary,#53647b);max-width:430px;line-height:1.3}"
