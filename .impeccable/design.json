  "narrative": {
    "northStar": "A neighborhood built one useful piece at a time",
    "overview": "A neighborhood built one useful piece at a time. The implemented world is a sunlit, terraced miniature: warm architectural plaster and brick, small plants, stairs, and paths under an orthographic camera.\n\nCompact white floating controls sit above the scene. Cobalt carries actions and selection, while brand-pinned Fraunces and Nunito Sans provide character and legibility. The architecture-only warm palette exception in PRODUCT.md and docs/implementation-contract.md does not extend to interface surfaces.",
    "keyCharacteristics": [
      "Full-viewport orthographic miniature with compact floating controls.",
      "Cool white interface surfaces and cobalt action states.",
      "Warm, varied architecture with matte materials and soft scene shadows.",
      "Brand-pinned Fraunces display type and Nunito Sans interface type."
    ],
    "rules": [
      {
        "name": "The World and Controls Rule",
        "body": "Keep warm plaster and brick in the game world; keep interface surfaces cool white and gray.",
        "section": "colors"
      },
      {
        "name": "The Brand Pairing Rule",
        "body": "Keep Fraunces for expressive titles and Nunito Sans for everyday controls; keycaps inherit the interface family.",
        "section": "typography"
      },
      {
        "name": "The Floating Surface Rule",
        "body": "Use soft shadows to separate compact controls from the scene, preserving the open canvas.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the pinned Fraunces/Nunito Sans pairing.",
      "Do retain 44px minimum button targets, visible keyboard focus, and explicit names for icon controls.",
      "Do pair placement colors with footprint geometry and reason text.",
      "Do honor reduced motion in both CSS transitions and renderer placement/camera motion."
    ],
    "donts": [
      "Don't apply the architectural warm-neutral exception to interface panels.",
      "Don't replace the compact floating palette with a permanent large sidebar.",
      "Don't infer hardware FPS or full accessibility conformance from browser automation."
    ]
  }
